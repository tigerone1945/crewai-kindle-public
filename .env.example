# LLM provider (CrewAI default: OpenAI). Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# Optional: model name used by the examples
# MODEL=gpt-5-mini

# Optional: disable CrewAI telemetry
# CREWAI_DISABLE_TELEMETRY=true

# Optional (chapter 14): URL of the analysis API that the Streamlit UI calls
# ANALYSIS_API_URL=http://127.0.0.1:8000

# Optional (chapter 15): PostgreSQL. Unset = SQLite files (chapters 1-14). Never commit real values.
# DATABASE_URL=postgresql://app:<password>@db:5432/sales
# DATABASE_SCHEMA=public
# DB_POOL_MAX=10
# POSTGRES_PASSWORD=<password for docker compose>
# TEST_DATABASE_URL=postgresql://postgres:devpassword@127.0.0.1:55432/sales   # for tests/postgres
